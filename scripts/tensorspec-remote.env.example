# Copy to scripts/tensorspec-remote.env (gitignored) and fill in site-specific values.
# Or set the same variables in your shell / deployment environment.
#
# Never commit tensorspec-remote.env — it may contain account names and host aliases.

# SSH host alias from ~/.ssh/config (required for live runs unless --host is passed)
TENSORSPEC_SLURM_HOST=

# Slurm project account (-A), required for live runs unless --account is passed
TENSORSPEC_SLURM_ACCOUNT=

# Slurm QoS (-q). Common values: regular, debug, interactive (site-specific).
TENSORSPEC_SLURM_QOS=regular

# Slurm constraint (-C): cpu, gpu, or site-specific label.
TENSORSPEC_SLURM_CONSTRAINT=cpu

# Nodes (-N) and MPI tasks (--ntasks / --np)
TENSORSPEC_SLURM_NODES=1
TENSORSPEC_SLURM_NTASKS=128

# Walltime (-t), HH:MM:SS
TENSORSPEC_SLURM_TIME=02:00:00

# Environment modules command argument (site-specific). Leave empty to rely on
# remote PATH (e.g. ~/tensorspec-solvers.env or conda) instead of module load.
TENSORSPEC_SLURM_MODULE=

# Optional remote scratch root. Empty = use remote $SCRATCH/qe_runs, else $HOME/qe_scratch.
TENSORSPEC_SLURM_SCRATCH=

# Cap for --ntasks / --np (safety)
TENSORSPEC_SLURM_MAX_NTASKS=512

# Poll interval while waiting for Slurm job (seconds)
TENSORSPEC_SLURM_POLL_INTERVAL=30
